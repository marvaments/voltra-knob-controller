// Copy this file to wifi_secrets.h (same folder) and fill in your own
// values. wifi_secrets.h is gitignored -- it's the one place a
// self-chosen OTA password lives, so it should never get committed or
// shared with the firmware zip.
//
// There is deliberately NO WiFi SSID/password constant in this file.
// WiFi credentials are never compiled into the firmware, on purpose --
// that's what makes it safe to mass-flash identical firmware for units
// you don't personally own (see wifi_provision.h/.cpp). Every board,
// including your own dev/bench units, joins a network at runtime via
// Settings > Wi-Fi > ADD WIFI: it briefly becomes its own hotspot, your
// phone connects to it, and you pick/type the real network there. That's
// the only way any board gets WiFi credentials, ever.
#pragma once

// A password of your own choosing that a computer must supply before it's
// allowed to push firmware to this board over your network (this is
// SEPARATE from your WiFi password). Leave it empty to allow OTA with no
// password at all -- only reasonable on a network you fully trust.
constexpr char kOtaPassword[] = "";

// Base URL this board checks for pull-based firmware updates (see
// ota_update.h) -- e.g. "http://192.168.1.50:8000" for a laptop running
// tools/serve_ota_test.py on your own WiFi while testing, or eventually a
// real https:// host once this ships to units you don't have physical/LAN
// access to. Leave empty to disable update checking entirely (the
// Settings > Firmware Update screen will just say "Not configured"). This
// is a completely different mechanism from kOtaPassword/ArduinoOTA above:
// that's YOU pushing a build from PlatformIO to a board on your LAN; this
// is the board itself reaching out and pulling from wherever you point it.
constexpr char kOtaUpdateBaseUrl[] = "";
